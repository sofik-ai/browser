# The Sofik engine: Sofik's own embedder of the content layer.
#
# It replaces CEF and, with it, the whole //chrome product layer CEF's Chrome
# runtime drags in. It stands on //headless, which already is a complete,
# small embedder (browser main parts, contexts, web contents, DevTools), and
# adds what a Browser Card needs on top: frames for a Flutter texture, input,
# and the identity of a real Chrome.

import("//headless/headless.gni")

# Milestone 1. Proves the critical path without CEF or //chrome: load a page,
# take frames from the compositor through the same FrameSinkVideoCapturer the
# Flutter texture will be fed by, write one out as a PNG.
executable("sofik_engine_probe") {
  testonly = false

  sources = [
    "probe.cc",
    "probe_main.cc",
  ]

  deps = [
    "//base",
    "//components/os_crypt/common:switches",
    "//components/viz/host",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//headless:headless_shell_lib",
    "//media/capture:capture_base",
    "//media/capture/mojom:video_capture",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//url",
  ]

  if (is_mac) {
    deps += [ "//sandbox/mac:seatbelt" ]
  }
  if (is_win) {
    deps += [
      "//build/win:default_exe_manifest",
      "//content:sandbox_helper_win",
      "//sandbox/win:common",
    ]
  }
}

# The engine: what a host application links. Everything it exports is the C
# API in sofik_engine.h and nothing else -- the rest of Chromium stays behind
# hidden visibility.
shared_library("sofik_engine") {
  sources = [
    "devtools_frontend.cc",
    "devtools_frontend.h",
    "downloads.cc",
    "downloads.h",
    "engine.cc",
    "engine.h",
    "offscreen_contents_view.cc",
    "offscreen_contents_view.h",
    "offscreen_view.cc",
    "offscreen_view.h",
    "sofik_engine.h",
    "view.cc",
    "view.h",
  ]
  if (is_mac) {
    sources += [
      "host_loop_pump_mac.mm",
      "view_mac.mm",
    ]
    frameworks = [
      "Cocoa.framework",
      "CoreFoundation.framework",
    ]
  }
  defines = [ "SOFIK_ENGINE_IMPLEMENTATION" ]

  # The C API and nothing else. Hidden visibility is the default in this
  # build, but V8 and the Rust runtime mark some 1,400 symbols default, and
  # they would otherwise become part of what a host can link against -- and
  # collide with, should the host carry a V8 of its own.
  #
  # And an install name a host can resolve from wherever it puts the library:
  # outside a component build the toolchain leaves "./libsofik_engine.dylib",
  # which only loads when the working directory happens to be the library's.
  if (is_mac) {
    ldflags = [
      "-Wl,-exported_symbol,_sofik_*",
      "-Wl,-install_name,@rpath/libsofik_engine.dylib",
    ]
  }

  deps = [
    "//base",
    "//cc",
    "//components/download/public/common:public",
    "//components/input",
    "//components/os_crypt/common:switches",
    "//components/viz/common",
    "//components/viz/host",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//headless:headless_shell_lib",
    "//ipc:mojom_constants",
    "//media",
    "//media/capture:capture_base",
    "//media/capture/mojom:video_capture",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/base/cursor",
    "//ui/base/cursor/mojom:cursor_type",
    "//ui/compositor",
    "//ui/display",
    "//ui/events",
    "//ui/events:dom_keycode_converter",
    "//ui/events:events_base",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/gl",
    "//url",
  ]
  if (is_mac) {
    deps += [ "//sandbox/mac:seatbelt" ]
  }
}

# Renderer, GPU and utility processes.
executable("sofik_engine_helper") {
  sources = [ "helper_main.cc" ]
  deps = [ ":sofik_engine" ]
  if (is_mac) {
    # Next to the library, as in the build directory, or four levels below
    # it as <engine>/Helpers/<name>.app/Contents/MacOS/<name>, which is where
    # package_mac.py puts it.
    ldflags = [
      "-Wl,-rpath,@loader_path",
      "-Wl,-rpath,@loader_path/../../../..",
    ]
  }
}

if (is_mac) {
  # A test host that embeds the engine through the C API alone.
  executable("sofik_engine_host") {
    sources = [ "host_mac.mm" ]
    deps = [ ":sofik_engine" ]

    # Beside the engine, as in the build directory, or as an application
    # bundle with SofikEngine.framework in Contents/Frameworks -- which is
    # where it has to be: the sandbox lets a child process read the main
    # bundle and nothing else, so an engine outside it cannot load its own
    # resources.
    ldflags = [
      "-Wl,-rpath,@loader_path",
      "-Wl,-rpath,@loader_path/../Frameworks/SofikEngine.framework/Versions/A",
    ]
    data_deps = [ ":sofik_engine_helper" ]
    frameworks = [
      "Cocoa.framework",
      "CoreGraphics.framework",
      "IOSurface.framework",
      "QuartzCore.framework",
    ]
    configs -= [ "//build/config/compiler:chromium_code" ]
    configs += [ "//build/config/compiler:no_chromium_code" ]
  }

  group("sofik") {
    deps = [
      ":sofik_engine_helper",
      ":sofik_engine_host",
      ":sofik_engine_probe",
    ]
  }
}
